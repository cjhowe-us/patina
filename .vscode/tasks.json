{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "go",
      "label": "test",
      "detail": "go test",
      "command": "test",
      "problemMatcher": ["$go"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true
      },
      "options": {
        "env": {
          "UPDATE_SNAPS": "${input:updateSnaps}"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": false,
        "revealProblems": "onProblem"
      }
    },
    {
      "type": "go",
      "label": "build",
      "detail": "go build",
      "command": "build",
      "problemMatcher": ["$go"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": false,
        "revealProblems": "onProblem"
      }
    }
  ],
  "inputs": [
    {
      "id": "updateSnaps",
      "description": "Whether to update snapshots",
      "type": "pickString",
      "options": ["true", "false"],
      "default": "false"
    }
  ]
}
